# Root compose integrated stack.
POSTGRES_DB=proben_analytics
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5432
MONGO_PORT=27017
MQTT_PORT=1883
PROBEN_API_PORT=8080
PROBEN_TELEMETRY_PORT=8081
PROBEN_ADMIN_PORT=3000

PROBEN_JWT_SECRET=change-this-local-development-secret-32chars
PROBEN_TELEMETRY_SERVICE_JWT_SECRET=change-this-local-development-secret-32chars
PROBEN_CORS_ALLOWED_ORIGIN_PATTERNS=http://localhost:*,http://127.0.0.1:*

SPRING_DATASOURCE_URL=jdbc:postgresql://postgres:5432/proben_analytics
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=postgres
SPRING_MONGODB_URI=mongodb://mongo:27017/proben_telemetry
PROBEN_API_BASE_URL=http://proben-api:8080

PROBEN_ANALYTICS_AGGREGATION_WORKER_ENABLED=false
PROBEN_TELEMETRY_CANONICAL_WORKER_ENABLED=false
PROBEN_TELEMETRY_MQTT_ENABLED=true
PROBEN_TELEMETRY_MQTT_BROKER_URL=tcp://mqtt:1883
PROBEN_TELEMETRY_MQTT_USERNAME=
PROBEN_TELEMETRY_MQTT_PASSWORD=
PROBEN_TELEMETRY_MQTT_TLS_ENABLED=false

ADMIN_API_BASE_URL=http://localhost:8080
ADMIN_TELEMETRY_API_URL=http://localhost:8081
PROBEN_TELEMETRY_CORS_ALLOWED_ORIGIN_PATTERNS=http://localhost:*,http://127.0.0.1:*
