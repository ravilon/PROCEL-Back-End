SPRING_MONGODB_URI=mongodb://mongo:27017/proben_telemetry
PROBEN_API_BASE_URL=http://host.docker.internal:8080
PROBEN_JWT_SECRET=change-this-local-development-secret-32chars
PROBEN_TELEMETRY_SERVICE_JWT_SECRET=change-this-local-development-secret-32chars
PROBEN_TELEMETRY_CANONICAL_WORKER_ENABLED=false
PROBEN_TELEMETRY_MQTT_ENABLED=true
PROBEN_TELEMETRY_MQTT_BROKER_URL=tcp://mqtt:1883
PROBEN_TELEMETRY_MQTT_USERNAME=
PROBEN_TELEMETRY_MQTT_PASSWORD=
PROBEN_TELEMETRY_MQTT_TLS_ENABLED=false
PROBEN_TELEMETRY_PORT=8081
MONGO_PORT=27017
MQTT_PORT=1883
PROBEN_TELEMETRY_CORS_ALLOWED_ORIGIN_PATTERNS=http://localhost:*,http://127.0.0.1:*
