# PROBEN staging example. Copy to a secret manager or Coolify environment.
# Do not put real secrets in this versioned file.

COMPOSE_PROJECT_NAME=proben-staging

# Public staging URLs. Must not point to production.
PROBEN_API_BASE_URL=https://api-staging.example.invalid
PROBEN_TELEMETRY_BASE_URL=https://telemetry-staging.example.invalid
PROBEN_ADMIN_BASE_URL=https://admin-staging.example.invalid

# PostgreSQL staging only. Database and volume names must include "staging".
POSTGRES_HOST=postgres-staging
POSTGRES_PORT=5432
POSTGRES_DB=proben_staging_analytics
POSTGRES_USER=proben_staging
POSTGRES_PASSWORD=<set-in-coolify-secret>
SPRING_DATASOURCE_URL=jdbc:postgresql://postgres-staging:5432/proben_staging_analytics
SPRING_DATASOURCE_USERNAME=proben_staging
SPRING_DATASOURCE_PASSWORD=<set-in-coolify-secret>

# MongoDB staging only. Database and volume names must include "staging".
MONGO_HOST=mongo-staging
MONGO_PORT=27017
MONGO_DATABASE=proben_staging_telemetry
SPRING_MONGODB_URI=mongodb://proben_staging:<set-in-coolify-secret>@mongo-staging:27017/proben_staging_telemetry?authSource=admin

# MQTT staging only.
MQTT_HOST=mqtt-staging
MQTT_PORT=1883
PROBEN_TELEMETRY_MQTT_ENABLED=true
PROBEN_TELEMETRY_MQTT_BROKER_URL=tcp://mqtt-staging:1883
PROBEN_TELEMETRY_MQTT_CLIENT_ID=proben-telemetry-staging
PROBEN_TELEMETRY_MQTT_USERNAME=proben_staging
PROBEN_TELEMETRY_MQTT_PASSWORD=<set-in-coolify-secret>
PROBEN_TELEMETRY_MQTT_TLS_ENABLED=true

# JWT and service-to-service secrets. Set real values only in Coolify secrets.
PROBEN_JWT_SECRET=<set-in-coolify-secret-at-least-32-chars>
PROBEN_TELEMETRY_SERVICE_JWT_SECRET=<set-in-coolify-secret-at-least-32-chars>
PROBEN_BOOTSTRAP_ADMIN_ENABLED=false
PROBEN_BOOTSTRAP_ADMIN_EMAIL=admin-staging@example.invalid
PROBEN_BOOTSTRAP_ADMIN_PASSWORD=<set-in-coolify-secret>

# Staging CORS. Keep explicit; do not use production domains.
PROBEN_CORS_ALLOWED_ORIGIN_PATTERNS=https://admin-staging.example.invalid

# Canonical ingestion worker in Telemetry.
PROBEN_TELEMETRY_CANONICAL_WORKER_ENABLED=true
PROBEN_TELEMETRY_WORKER_POLL_INTERVAL=PT2S
PROBEN_TELEMETRY_WORKER_LEASE_TIMEOUT=PT30S
PROBEN_TELEMETRY_WORKER_BATCH_SIZE=10
PROBEN_TELEMETRY_WORKER_MAX_ATTEMPTS=5
PROBEN_TELEMETRY_WORKER_BACKOFF=PT2S,PT5S,PT15S,PT1M,PT5M

# Mission event request worker in API.
PROBEN_MISSIONS_EVALUATION_WORKER_ENABLED=true
PROBEN_MISSIONS_EVALUATION_FIXED_DELAY=2s
PROBEN_MISSIONS_EVALUATION_BATCH_SIZE=20
PROBEN_MISSIONS_EVALUATION_LEASE_DURATION=30s
PROBEN_MISSIONS_EVALUATION_MAX_ATTEMPTS=5
PROBEN_MISSIONS_EVALUATION_INITIAL_BACKOFF=2s
PROBEN_MISSIONS_EVALUATION_MAX_BACKOFF=1m

# Temporal windows in API. Drools is used only for temporal flow; Simple remains default.
PROBEN_MISSIONS_RULE_ENGINE=simple
PROBEN_MISSIONS_EVALUATION_TEMPORAL_WINDOWS_ENABLED=true
PROBEN_MISSIONS_EVALUATION_TEMPORAL_WINDOWS_WORKER_ENABLED=true
PROBEN_MISSIONS_EVALUATION_TEMPORAL_WINDOWS_DROOLS_ENABLED=true
PROBEN_MISSIONS_EVALUATION_TEMPORAL_WINDOWS_ACTIVITIES_ENABLED=false
PROBEN_MISSIONS_EVALUATION_TEMPORAL_WINDOWS_FIXED_DELAY=2s
PROBEN_MISSIONS_EVALUATION_TEMPORAL_WINDOWS_BATCH_SIZE=20
PROBEN_MISSIONS_EVALUATION_TEMPORAL_WINDOWS_LEASE_DURATION=30s
PROBEN_MISSIONS_EVALUATION_TEMPORAL_WINDOWS_MAX_ATTEMPTS=5
PROBEN_MISSIONS_EVALUATION_TEMPORAL_WINDOWS_MAX_BACKLOG=1000
PROBEN_MISSIONS_EVALUATION_TEMPORAL_WINDOWS_INITIAL_BACKOFF=2s
PROBEN_MISSIONS_EVALUATION_TEMPORAL_WINDOWS_MAX_BACKOFF=1m
PROBEN_MISSIONS_EVALUATION_TEMPORAL_WINDOWS_MAXIMUM_SAMPLE_GAP=5s
PROBEN_MISSIONS_EVALUATION_TEMPORAL_WINDOWS_MAXIMUM_WINDOW_DURATION=10m

# Drools operational limits for staging validation.
PROBEN_MISSIONS_DROOLS_MAX_FACTS_PER_EVALUATION=5000
PROBEN_MISSIONS_DROOLS_MAX_CACHE_ENTRIES=200
PROBEN_MISSIONS_DROOLS_CACHE_EXPIRATION=30m
PROBEN_MISSIONS_DROOLS_COMPILATION_TIMEOUT=10s
PROBEN_MISSIONS_DROOLS_EVALUATION_TIMEOUT=5s
PROBEN_MISSIONS_DROOLS_MAXIMUM_SAMPLE_GAP=5s
PROBEN_MISSIONS_DROOLS_MAXIMUM_EVALUATION_SPAN=10m

# Analytics worker remains unrelated to this validation.
PROBEN_ANALYTICS_AGGREGATION_WORKER_ENABLED=false
PROBEN_TELEMETRY_CORS_ALLOWED_ORIGIN_PATTERNS=https://admin-staging.example.invalid
