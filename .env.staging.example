# PROCEL staging example. Copy to a secret manager or Coolify environment.
# Do not put real secrets in this versioned file.

COMPOSE_PROJECT_NAME=procel-staging

# Public staging URLs. Must not point to production.
PROCEL_API_BASE_URL=https://api-staging.example.invalid
PROCEL_TELEMETRY_BASE_URL=https://telemetry-staging.example.invalid
PROCEL_ADMIN_BASE_URL=https://admin-staging.example.invalid

# PostgreSQL staging only. Database and volume names must include "staging".
POSTGRES_HOST=postgres-staging
POSTGRES_PORT=5432
POSTGRES_DB=procel_staging_analytics
POSTGRES_USER=procel_staging
POSTGRES_PASSWORD=<set-in-coolify-secret>
SPRING_DATASOURCE_URL=jdbc:postgresql://postgres-staging:5432/procel_staging_analytics
SPRING_DATASOURCE_USERNAME=procel_staging
SPRING_DATASOURCE_PASSWORD=<set-in-coolify-secret>

# MongoDB staging only. Database and volume names must include "staging".
MONGO_HOST=mongo-staging
MONGO_PORT=27017
MONGO_DATABASE=procel_staging_telemetry
SPRING_MONGODB_URI=mongodb://procel_staging:<set-in-coolify-secret>@mongo-staging:27017/procel_staging_telemetry?authSource=admin

# MQTT staging only.
MQTT_HOST=mqtt-staging
MQTT_PORT=1883
PROCEL_TELEMETRY_MQTT_ENABLED=true
PROCEL_TELEMETRY_MQTT_BROKER_URL=tcp://mqtt-staging:1883
PROCEL_TELEMETRY_MQTT_CLIENT_ID=procel-telemetry-staging
PROCEL_TELEMETRY_MQTT_USERNAME=procel_staging
PROCEL_TELEMETRY_MQTT_PASSWORD=<set-in-coolify-secret>
PROCEL_TELEMETRY_MQTT_TLS_ENABLED=true

# JWT and service-to-service secrets. Set real values only in Coolify secrets.
PROCEL_JWT_SECRET=<set-in-coolify-secret-at-least-32-chars>
PROCEL_TELEMETRY_SERVICE_JWT_SECRET=<set-in-coolify-secret-at-least-32-chars>
PROCEL_BOOTSTRAP_ADMIN_ENABLED=false
PROCEL_BOOTSTRAP_ADMIN_EMAIL=admin-staging@example.invalid
PROCEL_BOOTSTRAP_ADMIN_PASSWORD=<set-in-coolify-secret>

# Staging CORS. Keep explicit; do not use production domains.
PROCEL_CORS_ALLOWED_ORIGIN_PATTERNS=https://admin-staging.example.invalid

# Canonical ingestion worker in Telemetry.
PROCEL_TELEMETRY_CANONICAL_WORKER_ENABLED=true
PROCEL_TELEMETRY_WORKER_POLL_INTERVAL=PT2S
PROCEL_TELEMETRY_WORKER_LEASE_TIMEOUT=PT30S
PROCEL_TELEMETRY_WORKER_BATCH_SIZE=10
PROCEL_TELEMETRY_WORKER_MAX_ATTEMPTS=5
PROCEL_TELEMETRY_WORKER_BACKOFF=PT2S,PT5S,PT15S,PT1M,PT5M

# Mission event request worker in API.
PROCEL_MISSIONS_EVALUATION_WORKER_ENABLED=true
PROCEL_MISSIONS_EVALUATION_FIXED_DELAY=2s
PROCEL_MISSIONS_EVALUATION_BATCH_SIZE=20
PROCEL_MISSIONS_EVALUATION_LEASE_DURATION=30s
PROCEL_MISSIONS_EVALUATION_MAX_ATTEMPTS=5
PROCEL_MISSIONS_EVALUATION_INITIAL_BACKOFF=2s
PROCEL_MISSIONS_EVALUATION_MAX_BACKOFF=1m

# Temporal windows in API. Drools is used only for temporal flow; Simple remains default.
PROCEL_MISSIONS_RULE_ENGINE=simple
PROCEL_MISSIONS_EVALUATION_TEMPORAL_WINDOWS_ENABLED=true
PROCEL_MISSIONS_EVALUATION_TEMPORAL_WINDOWS_WORKER_ENABLED=true
PROCEL_MISSIONS_EVALUATION_TEMPORAL_WINDOWS_DROOLS_ENABLED=true
PROCEL_MISSIONS_EVALUATION_TEMPORAL_WINDOWS_ACTIVITIES_ENABLED=false
PROCEL_MISSIONS_EVALUATION_TEMPORAL_WINDOWS_FIXED_DELAY=2s
PROCEL_MISSIONS_EVALUATION_TEMPORAL_WINDOWS_BATCH_SIZE=20
PROCEL_MISSIONS_EVALUATION_TEMPORAL_WINDOWS_LEASE_DURATION=30s
PROCEL_MISSIONS_EVALUATION_TEMPORAL_WINDOWS_MAX_ATTEMPTS=5
PROCEL_MISSIONS_EVALUATION_TEMPORAL_WINDOWS_MAX_BACKLOG=1000
PROCEL_MISSIONS_EVALUATION_TEMPORAL_WINDOWS_INITIAL_BACKOFF=2s
PROCEL_MISSIONS_EVALUATION_TEMPORAL_WINDOWS_MAX_BACKOFF=1m
PROCEL_MISSIONS_EVALUATION_TEMPORAL_WINDOWS_MAXIMUM_SAMPLE_GAP=5s
PROCEL_MISSIONS_EVALUATION_TEMPORAL_WINDOWS_MAXIMUM_WINDOW_DURATION=10m

# Drools operational limits for staging validation.
PROCEL_MISSIONS_DROOLS_MAX_FACTS_PER_EVALUATION=5000
PROCEL_MISSIONS_DROOLS_MAX_CACHE_ENTRIES=200
PROCEL_MISSIONS_DROOLS_CACHE_EXPIRATION=30m
PROCEL_MISSIONS_DROOLS_COMPILATION_TIMEOUT=10s
PROCEL_MISSIONS_DROOLS_EVALUATION_TIMEOUT=5s
PROCEL_MISSIONS_DROOLS_MAXIMUM_SAMPLE_GAP=5s
PROCEL_MISSIONS_DROOLS_MAXIMUM_EVALUATION_SPAN=10m

# Analytics worker remains unrelated to this validation.
PROCEL_ANALYTICS_AGGREGATION_WORKER_ENABLED=false
PROCEL_TELEMETRY_CORS_ALLOWED_ORIGIN_PATTERNS=https://admin-staging.example.invalid
